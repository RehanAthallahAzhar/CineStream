          "script": {
            "exec": [
              "// Mengambil response body dalam format JSON\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "// Memeriksa apakah ada properti \"token\" di dalam response\r",
              "if (jsonData && jsonData.data.token) {\r",
              "    // Menyimpan nilai token ke environment variable bernama \"auth_token\"\r",
              "    pm.environment.set(\"auth_token\", jsonData.data.token);\r",
              "    console.log(\"Auth Token berhasil disimpan!\");\r",
              "}"
